# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

# Create library sets for GPDK 45nm technology
create_library_set -name gpdk_45_slow -timing {libs/slow_vdd1v0_basicCells.lib libs/pads_FF_s1vg.lib}
create_library_set -name gpdk_45_fast -timing {libs/fast_vdd1v0_basicCells.lib libs/pads_FF_s1vg.lib}


# Create RC corners
create_rc_corner -name rc_corner_gpdk_slow -T {125} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0} -qx_tech_file {libs/gpdk045.tch}
create_rc_corner -name rc_corner_gpdk_fast -T {0} -preRoute_res {1.0} -preRoute_cap {1.0} -preRoute_clkres {0.0} -preRoute_clkcap {0.0} -postRoute_res {1.0} -postRoute_cap {1.0} -postRoute_xcap {1.0} -postRoute_clkres {0.0} -postRoute_clkcap {0.0} -qx_tech_file {libs/gpdk045.tch}

# Create delay corners
create_delay_corner -name delay_corner_gpdk_slow \
    -library_set gpdk_45_slow \
    -opcond op_cond_gpdk_45_slow \
    -rc_corner rc_corner_gpdk_slow

create_delay_corner -name delay_corner_gpdk_fast \
    -library_set gpdk_45_fast \
    -opcond op_cond_gpdk_45_fast \
    -rc_corner rc_corner_gpdk_fast

# Create constraint mode
create_constraint_mode -name gpdk_45_constraint_mode \
    -sdc_files { rtl/aps25_cpu.sdc}

# Create analysis view
create_analysis_view -name slow \
    -constraint_mode gpdk_45_constraint_mode \
    -delay_corner delay_corner_gpdk_slow

create_analysis_view -name fast \
    -constraint_mode gpdk_45_constraint_mode \
    -delay_corner delay_corner_gpdk_fast

# Set the analysis view for setup and hold
set_analysis_view -setup fast -hold fast
